# StepCode Scholar AI Engine — Environment Configuration
# Copy this file to .env for custom deployments

# Application settings
APP_NAME="StepCode - Scholar AI Engine"
API_V1_PREFIX="/api"
DEBUG=False

# Database URL (SQLite default for local development, or PostgreSQL connection string)
DATABASE_URL="sqlite:///./stepcode.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/stepcode"

# Allowed CORS Origins (comma-separated, default "*" for development)
CORS_ORIGINS="*"
# CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
